# Copia este archivo como .env para desarrollo local. Nunca subas el .env.

# PostgreSQL. En Azure: sin DB_PASSWORD (identidad gestionada) y DB_PORT por defecto.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wawa
DB_USER=wawa
DB_PASSWORD=wawa_local

# Blob Storage. En Azure: STORAGE_ACCOUNT_URL (identidad gestionada).
# En local con Azurite (docker compose): solo STORAGE_CONNECTION_STRING.
# Sin ninguna de las dos: Blob en memoria (se pierde al reiniciar).
STORAGE_ACCOUNT_URL=
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Key Vault. Vacio = ProveedorClaves falso (clave RSA local).
KEYVAULT_URL=
DONATION_KEY_NAME=wawa-donaciones

# Azure OpenAI. Vacio = ProveedorLLM falso (respuestas fijas).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Secretos: en Azure llegan desde Key Vault. En local, genera valores largos con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
INTERNAL_API_KEY=

# Dominios de la app web, separados por comas
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
